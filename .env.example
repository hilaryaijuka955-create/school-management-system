# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/school_management_db
# OR for MySQL:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/school_management_db

# Server Configuration
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production
DEBUG=False
ENVIRONMENT=development

# API Configuration
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8000
API_PORT=5000

# File Uploads
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Payment Provider (Optional)
PAYMENT_PROVIDER_API_KEY=your-payment-provider-api-key
PAYMENT_PROVIDER_URL=https://api.payment-provider.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Session Configuration
SESSION_TIMEOUT=3600
REFRESH_TOKEN_EXPIRY=604800

# School Settings (Can be changed in app, stored in database)
SCHOOL_NAME=Your School Name
SCHOOL_LOGO_PATH=./assets/school-logo.png
SCHOOL_MOTTO=Your School Motto

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# CORS Configuration
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Feature Flags
ENABLE_STUDENT_EXAMS=True
ENABLE_PARENT_APP=True
ENABLE_MOBILE_MONEY=False
ENABLE_ADVANCED_REPORTS=True

# Sync Configuration
SYNC_BATCH_SIZE=100
SYNC_TIMEOUT=30
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=5

# Security
ENABLE_2FA=False
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=False

# API Documentation
ENABLE_SWAGGER=True
SWAGGER_URL=/api/docs
